ENVIRONMENT=production
APP_BIND=127.0.0.1
APP_PORT=8010
MONGO_DB=enbypro
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
DEFAULT_TENANT_SLUG=enbypro
DEFAULT_TENANT_NAME=ENBY PRO
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Administrador ENBY PRO
ALLOW_SELF_REGISTER=false
TRUST_PROXY_HEADERS=true
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
IMAGE_GEN_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_MAX_RESPONSE_MB=32
GENERATION_LIMIT_PER_HOUR=20
PDF_PROVIDER=mock
MEDIA_ROOT=/app/var/media
MAX_UPLOAD_MB=25
MAX_IMAGE_MEGAPIXELS=50
