# Render Artelux — copie para .env e ajuste. NUNCA versione o .env.

# MongoDB (no docker compose o host é o serviço "mongo")
MONGO_URL=mongodb://mongo:27017
MONGO_DB=estudio_render

# Segredo de assinatura do JWT (Fase 2). Gere um valor próprio.
JWT_SECRET=troque-este-valor-em-cada-ambiente
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Adaptadores de integração (mock = sem rede, sem credencial)
IMAGE_GEN_PROVIDER=mock
PDF_PROVIDER=mock

# Tenant fixo desta instalação
DEFAULT_TENANT_SLUG=artelux
DEFAULT_TENANT_NAME=ARTELUX

# Owner de desenvolvimento criado pelo seed na subida.
# Deixe em branco para não criar nenhum usuário automaticamente.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Owner ARTELUX

# Registro interno aberto (Fase 2 não tem convites). false fecha o /api/auth/register.
ALLOW_SELF_REGISTER=true

# Diretório servido com o build do frontend (produção/single-service)
FRONTEND_DIST=frontend/dist
