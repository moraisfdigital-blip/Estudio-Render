# Render Artelux — copie para .env e ajuste. NUNCA versione o .env.

# Ambiente. `production` é o padrão do código: instalação que esquecer de
# declarar nasce fechada. Em `production`, /docs e /openapi.json deixam de
# existir e o HSTS é enviado. Use `development` na sua máquina.
ENVIRONMENT=development

# MongoDB (no docker compose o host é o serviço "mongo")
MONGO_URL=mongodb://mongo:27017
MONGO_DB=estudio_render

# Segredo de assinatura do JWT (Fase 2). OBRIGATÓRIO: sem ele o app não sobe,
# e abaixo de 32 caracteres ele recusa a subir. Um valor diferente por ambiente.
# Gere o seu:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Só HS256, HS384 ou HS512. Qualquer outro valor — inclusive "none", que
# desliga a verificação de assinatura — faz o app recusar subir.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Adaptadores de integração (mock = sem rede, sem credencial)
IMAGE_GEN_PROVIDER=mock
PDF_PROVIDER=mock

# Tenant fixo desta instalação
DEFAULT_TENANT_SLUG=artelux
DEFAULT_TENANT_NAME=ARTELUX

# Owner de desenvolvimento criado pelo seed na subida.
# Deixe em branco para não criar nenhum usuário automaticamente.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Owner ARTELUX

# Registro interno aberto (Fase 2 não tem convites). false fecha o /api/auth/register.
ALLOW_SELF_REGISTER=true

# Diretório servido com o build do frontend (produção/single-service)
FRONTEND_DIST=frontend/dist

# Fase 4 — storage das fotos. Raiz onde os ORIGINAIS são gravados (relativa à
# raiz do repo ou absoluta). Em produção aponte para um volume persistente;
# nunca deixe um caminho de produção chumbado no código.
# O original nunca é sobrescrito: derivados de fases futuras vão para arquivos
# novos dentro da mesma pasta da foto.
MEDIA_ROOT=var/media

# Tamanho máximo por foto, em MB.
MAX_UPLOAD_MB=25

# Teto de RESOLUÇÃO, que é diferente do teto de tamanho: um PNG de 132 bytes
# pode declarar 9000x8000 px e derrubar o servidor na hora de decodificar.
# 50 Mpx é folgado para foto de celular (um iPhone faz 12 Mpx).
MAX_IMAGE_MEGAPIXELS=50
